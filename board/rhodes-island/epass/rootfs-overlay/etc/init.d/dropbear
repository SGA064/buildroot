#!/bin/sh

# Allow a few customizations from a config file.
# shellcheck source=/dev/null
[ ! -r /etc/default/dropbear ] || . /etc/default/dropbear

start()
{
	DROPBEAR_ARGS="${DROPBEAR_ARGS:-} -R"

	if [ -L /etc/dropbear ] &&
	   [ "$(readlink /etc/dropbear)" = "/var/run/dropbear" ]; then
		if rm -f /etc/dropbear >/dev/null 2>&1; then
			mkdir -p /etc/dropbear
		else
			mkdir -p "$(readlink /etc/dropbear)"
		fi
	fi

	printf 'Starting dropbear sshd: '
	umask 077
	# DROPBEAR_ARGS intentionally expands to individual daemon arguments.
	# shellcheck disable=SC2086
	if start-stop-daemon -S -q -p /var/run/dropbear.pid \
		--exec /usr/sbin/dropbear -- $DROPBEAR_ARGS; then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop()
{
	printf 'Stopping dropbear sshd: '
	if start-stop-daemon -K -q -p /var/run/dropbear.pid; then
		echo "OK"
	else
		echo "FAIL"
	fi
}

case "$1" in
start)
	start
	;;
stop)
	stop
	;;
restart|reload)
	stop
	start
	;;
*)
	echo "Usage: $0 {start|stop|restart|reload}" >&2
	exit 1
	;;
esac
