// SPDX-License-Identifier: GPL-2.0+

/dts-v1/;

/ {
	description = "Linux FIT image for Rhodes Island ePass";
	#address-cells = <1>;

	images {
		kernel {
			description = "ARM zImage";
			data = /incbin/("./zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x80008000>;
			entry = <0x80008000>;
			hash {
				algo = "crc32";
			};
		};

		fdt-epass {
			description = "Rhodes Island ePass device tree";
			data = /incbin/("./suniv-f1c200s-epass.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			hash {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "conf-epass";

		conf-epass {
			description = "Rhodes Island ePass";
			kernel = "kernel";
			fdt = "fdt-epass";
		};
	};
};
