config BR2_PACKAGE_FPLAYERDEMO
	bool "fplayerdemo"
	depends on BR2_TOOLCHAIN_HAS_THREADS # alsa-lib, ffmpeg, libdrm
	depends on BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_PCM
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_LIBDRM
	help
	  F1C200S Cedrus/KMS player and diagnostics demo.

	  It uses a built-in MP4/H.264 parser, the V4L2 stateless
	  request API for Cedrus decode, KMS/DRM for display,
	  FFmpeg/libavcodec for AAC decoding, and ALSA for audio output.

comment "fplayerdemo needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS

comment "fplayerdemo needs FFmpeg support on this architecture"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
