config BR2_PACKAGE_FPLAYERDEMO
	bool "fplayerdemo"
	depends on BR2_TOOLCHAIN_HAS_THREADS # alsa-lib, ffmpeg, gstreamer1
	depends on BR2_USE_WCHAR # gstreamer1
	depends on BR2_USE_MMU # gstreamer1
	depends on BR2_INSTALL_LIBSTDCPP # gst1-plugins-bad
	depends on BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_PCM
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_GST1_PLUGINS_BAD
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS
	select BR2_PACKAGE_GSTREAMER1
	select BR2_PACKAGE_LIBDRM
	help
	  F1C200S Cedrus/KMS player and diagnostics demo.

	  It uses FFmpeg/libavformat for common container demuxing,
	  gst-codecparsers for H.264 metadata parsing, V4L2 stateless
	  request API for Cedrus decode, KMS/DRM for display, and ALSA
	  for audio output.

comment "fplayerdemo needs a toolchain w/ wchar, threads, C++"
	depends on BR2_USE_MMU
	depends on !BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_INSTALL_LIBSTDCPP

comment "fplayerdemo needs FFmpeg support on this architecture"
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
